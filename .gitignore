# Dependencies — never commit node_modules
node_modules/

# Build output
dist/
build/

# Environment / secret files — never commit API keys
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# macOS metadata
.DS_Store

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User data lives in ~/Byte/ (outside this repo).
# These entries are a safety net in case someone symlinks them here.
settings.json
user-data/
