{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LessonText",
  "type": "object",
  "required": ["blocks", "placements"],
  "additionalProperties": true,
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["section_id", "kind", "body"],
        "additionalProperties": true,
        "properties": {
          "section_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["hook", "chunk", "apply", "recall"] },
          "body": { "type": "string", "minLength": 1 },
          "visual": { "type": "string" },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "recall_day": { "type": "integer" },
          "answer": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "chunk" } }, "required": ["kind"] },
            "then": { "required": ["visual"], "properties": { "visual": { "minLength": 1 } } }
          },
          {
            "if": { "properties": { "kind": { "const": "recall" } }, "required": ["kind"] },
            "then": { "required": ["answer"], "properties": { "answer": { "minLength": 1 } } }
          }
        ]
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["after_section", "artifact_type", "note"],
        "additionalProperties": true,
        "properties": {
          "after_section": { "type": "string", "minLength": 1 },
          "artifact_type": {
            "type": "string",
            "enum": ["flip-card-deck", "knowledge-check", "scenario-branching", "tabs"]
          },
          "note": { "type": "string", "minLength": 1 }
        }
      },
      "contains": {
        "type": "object",
        "required": ["artifact_type"],
        "properties": { "artifact_type": { "enum": ["knowledge-check", "scenario-branching"] } }
      }
    }
  }
}
