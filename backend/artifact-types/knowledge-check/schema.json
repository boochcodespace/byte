{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeCheckArtifact",
  "type": "object",
  "required": ["learning_objective", "setup", "items", "apply_today"],
  "additionalProperties": true,
  "properties": {
    "learning_objective": { "type": "string", "minLength": 1 },
    "estimated_minutes": { "type": "number" },
    "setup": { "type": "string", "minLength": 1 },
    "visual_anchor_description": { "type": "string" },
    "apply_today": { "type": "string", "minLength": 1 },
    "spaced_repetition_notes": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stem", "options"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "bloom_level": { "type": "string" },
          "difficulty": { "type": "string" },
          "scenario": { "type": "string" },
          "stem": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["text", "correct", "rationale"],
              "additionalProperties": true,
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "correct": { "type": "boolean" },
                "rationale": { "type": "string", "minLength": 1 }
              }
            },
            "contains": {
              "type": "object",
              "required": ["correct"],
              "properties": { "correct": { "const": true } }
            }
          }
        }
      }
    }
  }
}
